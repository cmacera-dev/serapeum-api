{
  "name": "serapeum-api",
  "version": "1.0.3",
  "description": "Serapeum API - AI orchestration service powered by Genkit",
  "type": "module",
  "main": "dist/src/index.js",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "genkit:start": "genkit start -- npx tsx watch src/index.ts",
    "genkit:start:ts": "npm run genkit:start 2>&1 | while IFS= read -r line; do printf '[%s] %s\\n' \"$(date +%H:%M:%S)\" \"$line\"; done",
    "dev:build": "tsc --watch",
    "dev:run": "node --watch dist/index.js",
    "prebuild": "npm run build -w packages/shared-schemas",
    "build": "tsc && cp -r src/locales dist/",
    "start": "node dist/src/index.js",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run --coverage",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "check:lockfile": "node --import tsx/esm scripts/check-lockfile.ts",
    "check:blockers": "node --import tsx/esm scripts/check-dependency-blockers.ts",
    "eval:compare": "node --import tsx/esm scripts/evalCompare.ts",
    "compare:evals": "node --import tsx/esm scripts/compareEvals.ts",
    "generate:openapi": "node --import tsx/esm scripts/generate-openapi.ts",
    "sync:flutter": "npm run generate:openapi && node --import tsx/esm scripts/sync-flutter.ts",
    "release": "bash scripts/release.sh",
    "release:minor": "bash scripts/release.sh minor",
    "release:major": "bash scripts/release.sh major",
    "release:tag": "bash scripts/release-tag.sh",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cmacera/serapeum-api.git"
  },
  "keywords": [
    "genkit",
    "ai",
    "api",
    "typescript",
    "node"
  ],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/cmacera/serapeum-api/issues"
  },
  "homepage": "https://github.com/cmacera/serapeum-api#readme",
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@genkit-ai/ai": "^1.41.0",
    "@genkit-ai/core": "^1.41.0",
    "@genkit-ai/express": "^1.41.0",
    "@genkit-ai/google-genai": "^1.41.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.52.1",
    "@opentelemetry/sdk-trace-node": "^1.25.1",
    "@tavily/core": "^0.7.8",
    "@vercel/functions": "^3.9.5",
    "axios": "^1.20.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "genkit": "^1.30.1",
    "genkitx-ollama": "^1.41.0",
    "genkitx-openai": "^0.30.0",
    "jose": "^6.2.10",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@asteasolutions/zod-to-openapi": "^7.3.4",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "genkit-cli": "^1.42.0",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "nock": "^14.0.17",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.6",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.0.18",
    "yaml": "^2.9.0"
  },
  "overrides": {
    "handlebars": "^4.7.9",
    "protobufjs": "^7.6.5",
    "@protobufjs/utf8": "^1.1.1",
    "@grpc/grpc-js": "^1.14.4",
    "node-forge": "^1.4.0",
    "websocket-driver": "^0.7.5",
    "fast-uri": "^3.1.5",
    "fast-xml-parser": "^5.7.0",
    "fast-xml-builder": "^1.1.7",
    "ws": "^8.21.0",
    "qs": "^6.15.3",
    "uuid@11": "^11.1.1",
    "form-data@2": "^2.5.6",
    "body-parser@1": "^1.20.6",
    "body-parser@2": "^2.3.0",
    "path-to-regexp@0.1": "^0.1.13",
    "path-to-regexp@8": "^8.4.0",
    "brace-expansion@2": "^2.1.2",
    "brace-expansion@5": "^5.0.9",
    "js-yaml": "^4.3.1",
    "postcss": "^8.5.23",
    "ip-address": "^10.3.1",
    "hono": "^4.12.34",
    "@hono/node-server": "^1.19.15",
    "esbuild": "^0.28.1",
    "adm-zip": "^0.6.0",
    "@tootallnate/once": "^2.0.1"
  }
}
